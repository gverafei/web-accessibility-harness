msgstr "Intentos de generación"

msgid "The proposal failed validation. Correcting it before evaluation."
msgstr "La propuesta no superó la validación. Se está corrigiendo antes de evaluarla."

msgid "The proposal made no effective change. No new candidate was evaluated."
msgstr "La propuesta no produjo cambios efectivos. No se evaluó una candidata nueva."

msgid "Stopped"
msgstr "Detenida"

msgid "Stopping…"
msgstr "Deteniendo…"

msgid "Finishing the current candidate; no further generation will start."
msgstr "Se está cerrando la candidata en curso; no se iniciará otra generación."

msgid "This execution has already finished."
msgstr "Esta ejecución ya terminó."

msgid "Stopped by user. Recorded results and charges were preserved."
msgstr "Detenida por el usuario. Se conservaron los resultados y los cargos registrados."

msgid "Could not request a stop. Please try again."
msgstr "No se pudo solicitar la detención. Inténtalo de nuevo."

msgid "Stop"
msgstr "Detener"
