msgid "Pages released for comparison"
msgstr "Páginas disponibles para comparar"

msgid "Compare the saved automatic acceptance decision with two independent human decisions. Each generated page is the retained final version of one run; the same domain can appear under different models and strategies."
msgstr "Compara la decisión automática guardada con dos decisiones humanas independientes. Cada página generada es la versión final conservada de una corrida; un mismo dominio puede aparecer con distintos modelos y estrategias."

msgid "Page decisions and review progress"
msgstr "Decisiones por página y avance de revisión"

msgid "All review stages"
msgstr "Todas las etapas de revisión"

msgid "Pending reviews"
msgstr "Revisiones pendientes"

msgid "Reviews complete; study still open"
msgstr "Revisiones completas; estudio aún abierto"

msgid "Study reviews complete"
msgstr "Revisiones del estudio completas"

msgid "All agreement outcomes"
msgstr "Todos los niveles de acuerdo"

msgid "Full agreement"
msgstr "Acuerdo total"

msgid "Partial agreement"
msgstr "Acuerdo parcial"

