# Application
WEB_HOST_PORT=80
APP_TIMEZONE=America/Mexico_City
SECRET_KEY=replace_for_your_local_environment
# Set true only behind the authorized HTTPS proxy; local loopback defaults stay unchanged.
SESSION_COOKIE_SECURE=false
EVALUATOR_URL=http://evaluator:3000
# Optional provenance labels; these do not select or download registry images.
DOCKER_WEB_IMAGE=local-build
DOCKER_EVALUATOR_IMAGE=local-build

# MySQL
MYSQL_DATABASE=a11yharness_experiments
MYSQL_USER=harness_user
MYSQL_PASSWORD=replace_with_a_new_private_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_private_password
DB_HOST=db
DB_PORT=3306
DB_NAME=a11yharness_experiments
DB_USER=harness_user
DB_PASSWORD=replace_with_a_new_private_password

# Optional semantic evaluation through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Dynamic-page stabilization
PAGE_LOAD_TIMEOUT_MS=60000
NETWORK_IDLE_TIMEOUT_MS=15000
PAGE_SETTLE_DELAY_MS=2000
DOM_STABILITY_WINDOW_MS=1500
DOM_STABILITY_TIMEOUT_MS=10000
ENABLE_LAZY_LOAD_SCROLL=true
SCROLL_STEP_PX=700
SCROLL_DELAY_MS=400
MAX_SCROLL_STEPS=30
